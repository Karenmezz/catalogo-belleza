---
import { Heart, ShoppingBag } from "@lucide/astro";

interface Props {
  nombreTienda: string;
}

const { nombreTienda } = Astro.props;
---

<header class="header">
  <a class="logo" href="/" aria-label={`Ir a la página principal de ${nombreTienda}`}>
    <img src="/images/Logo-tiendamezz.jpeg" alt="MEZZ Beauty" width="130" height="58" />
  </a>

  <nav aria-label="Navegación principal">
    <a class="category-link" href="/?categoria=maquillaje#productos"> Maquillaje </a>
    <a class="category-link" href="/?categoria=skincare#productos"> Skincare </a>
    <a class="category-link" href="/?categoria=cuidado-capilar#productos"> Cuidado capilar </a>
    <a class="category-link" href="/?categoria=cuidado-corporal#productos"> Cuidado corporal </a>

    <a class="favorites" href="/favoritos" aria-label="Ver favoritos">
      <Heart size={19} />
      <span>Favoritos</span>
      <b data-favorites-count>0</b>
    </a>

    <a class="cart" href="/carrito">
      <ShoppingBag size={18} />
      <span>Mi carrito</span>
      <b data-cart-count>0</b>
    </a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
    padding: 0 clamp(1rem, 5vw, 5rem);
    border-bottom: 1px solid var(--color-borde);
    background: rgb(255 255 255 / 96%);
    backdrop-filter: blur(10px);
  }

  .logo {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: 130px;
    height: 58px;
    object-fit: contain;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 1.8vw, 1.5rem);
  }

  nav a {
    color: inherit;
    font-size: 0.86rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .favorites,
  .cart {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
  }

  .favorites {
    padding: 0.55rem 0.75rem;
    border: 1px solid #e6d5db;
    border-radius: 999px;
    color: var(--color-principal);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .favorites:hover {
    color: #fff;
    background: var(--color-principal);
  }

  .favorites b,
  .cart b {
    display: inline-grid;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    place-items: center;
    border-radius: 999px;
    color: #fff;
    background: var(--color-principal);
    font-size: 0.7rem;
  }

  .favorites:hover b {
    color: var(--color-principal);
    background: #fff;
  }

  @media (max-width: 850px) {
    .category-link {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header {
      min-height: 68px;
    }

    .logo img {
      width: 100px;
      height: 48px;
    }

    .favorites {
      padding: 0.45rem 0.55rem;
    }

    .favorites > span {
      display: none;
    }

    .cart {
      font-size: 0.78rem;
    }
  }

  @media (max-width: 390px) {
    .header {
      padding: 0 0.65rem;
    }

    .logo img {
      width: 84px;
    }

    nav {
      gap: 0.45rem;
    }

    .cart > span {
      font-size: 0;
    }

    .cart > span::after {
      content: "Carrito";
      font-size: 0.72rem;
    }
  }
</style>

<script>
  import { cartCount } from "../scripts/cart";
  import { favoritesCount } from "../scripts/favorites";

  const updateCounts = () => {
    document.querySelectorAll("[data-cart-count]").forEach((element) => {
      element.textContent = String(cartCount());
    });

    document.querySelectorAll("[data-favorites-count]").forEach((element) => {
      element.textContent = String(favoritesCount());
    });
  };

  updateCounts();
  window.addEventListener("cart:updated", updateCounts);
  window.addEventListener("favorites:updated", updateCounts);
</script>
