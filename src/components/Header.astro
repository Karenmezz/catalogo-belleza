---
interface Props { nombreTienda:string; }
const { nombreTienda }=Astro.props;
---
<header class="header"><a class="logo" href="/" aria-label={`Ir a la página principal de ${nombreTienda}`}><img src="/images/logo-kf-ugc.png?v=3" alt={nombreTienda} width="52" height="52" /><strong>{nombreTienda}</strong></a><nav aria-label="Navegación principal"><a href="/?categoria=maquillaje#productos">Maquillaje</a><a href="/?categoria=skincare#productos">Skincare</a><a href="/?categoria=cuidado-capilar#productos">Cuidado capilar</a><a href="/?categoria=cuidado-corporal#productos">Cuidado corporal</a><a class="favorites" href="/favoritos" aria-label="Ver favoritos">♡ <span>Favoritos</span> <b data-favorites-count>0</b></a><a class="cart" href="/carrito">Mi selección <b data-cart-count>0</b></a></nav></header>
<style>.header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;min-height:82px;padding:0 clamp(1rem,5vw,5rem);border-bottom:1px solid var(--color-borde);background:rgba(255,255,255,.96);backdrop-filter:blur(10px)}.logo{display:flex;align-items:center;gap:.65rem;min-width:0;font-size:1rem;text-decoration:none}.logo img{width:58px;height:58px;object-fit:contain}.logo strong{white-space:nowrap}nav{display:flex;align-items:center;gap:clamp(.65rem,1.8vw,1.5rem)}nav a{text-decoration:none;font-size:.86rem;white-space:nowrap}.cart,.favorites{font-weight:700}.cart b,.favorites b{display:inline-grid;min-width:21px;height:21px;margin-left:.2rem;padding:0 5px;place-items:center;border-radius:20px;color:#fff;background:var(--color-principal);font-size:.7rem}.favorites{display:inline-flex;align-items:center;gap:.25rem;padding:.55rem .75rem;border:1px solid #e6d5db;border-radius:999px;color:var(--color-principal);font-size:1.15rem;transition:background .2s,color .2s}.favorites:hover{color:#fff;background:var(--color-principal)}.favorites:hover b{color:var(--color-principal);background:#fff}.favorites span{font-size:.8rem}@media(max-width:850px){.logo strong{display:none}nav>a:not(.cart):not(.favorites){display:none}}@media(max-width:600px){.header{min-height:68px}.logo img{width:48px;height:48px}.favorites{padding:.45rem .55rem}.favorites span{display:none}.cart{font-size:.78rem}}@media(max-width:360px){.header{padding:0 .65rem}.cart{font-size:0}.cart::before{content:'Selección';font-size:.72rem}}
.header .logo>img{display:block;width:52px!important;max-width:52px!important;height:52px!important;flex:0 0 52px;object-fit:contain}@media(max-width:600px){.header .logo>img{width:44px!important;max-width:44px!important;height:44px!important;flex-basis:44px}}
</style>
<script>import { cartCount } from "../scripts/cart";import { favoritesCount } from "../scripts/favorites";const update=()=>{document.querySelectorAll('[data-cart-count]').forEach(el=>el.textContent=String(cartCount()));document.querySelectorAll('[data-favorites-count]').forEach(el=>el.textContent=String(favoritesCount()))};update();window.addEventListener('cart:updated',update);window.addEventListener('favorites:updated',update);</script>
