---
interface Props {
  imagenes: string[];
  nombreProducto: string;
}
const { imagenes, nombreProducto } = Astro.props;
---

<div class="gallery-layout" data-carousel tabindex="0" aria-label={`Imágenes de ${nombreProducto}`}>
  {
    imagenes.length > 1 && (
      <div class="thumbnails" aria-label="Seleccionar imagen">
        {imagenes.map((imagen, index) => (
          <button
            class:list={["thumbnail", { active: index === 0 }]}
            type="button"
            data-thumbnail={index}
            aria-label={`Ver imagen ${index + 1}`}
          >
            <img src={imagen} alt="" loading="lazy" />
          </button>
        ))}
      </div>
    )
  }
  <div class="main-image">
    <div class="track" data-track>
      {
        imagenes.map((imagen, index) => (
          <img
            src={imagen}
            alt={`${nombreProducto}, imagen ${index + 1}`}
            loading={index === 0 ? "eager" : "lazy"}
          />
        ))
      }
    </div>
    {
      imagenes.length > 1 && (
        <>
          <>
            <button
              class="arrow previous"
              type="button"
              data-previous
              aria-label="Ver imagen anterior"
            >
              ←
            </button>
            <button class="arrow next" type="button" data-next aria-label="Ver imagen siguiente">
              →
            </button>
          </>
        </>
      )
    }
  </div>
</div>
<style>
  .gallery-layout {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
    outline: none;
  }
  .gallery-layout:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-principal) 35%, transparent);
    outline-offset: 5px;
  }
  .thumbnails {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .thumbnail {
    aspect-ratio: 1;
    width: 76px;
    padding: 0.35rem;
    overflow: hidden;
    border: 1px solid var(--color-borde);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .thumbnail.active,
  .thumbnail:hover {
    border-color: var(--color-principal);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-principal) 12%, transparent);
  }
  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .main-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid #eee;
    border-radius: 12px;
    background: var(--color-superficie);
  }
  .track {
    display: flex;
    height: 100%;
    transition: transform 0.35s ease;
  }
  .track > img {
    width: 100%;
    min-width: 100%;
    height: 100%;
    padding: 1.5rem;
    object-fit: contain;
  }
  .arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--color-borde);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 3px 12px rgb(0 0 0/0.08);
    cursor: pointer;
    transform: translateY(-50%);
  }
  .arrow:hover {
    color: #fff;
    border-color: var(--color-principal);
    background: var(--color-principal);
  }
  .previous {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
  @media (max-width: 600px) {
    .gallery-layout {
      grid-template-columns: 1fr;
    }
    .thumbnails {
      order: 2;
      flex-direction: row;
      overflow-x: auto;
    }
    .thumbnail {
      flex: 0 0 62px;
      width: 62px;
    }
    .track > img {
      padding: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }
</style>
<style>
  .main-image,
  .thumbnail,
  .thumbnail img,
  .track > img {
    background: #fff;
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const images = root.querySelectorAll<HTMLElement>(".track>img");
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-thumbnail]")];
    let current = 0;
    let touchStart = 0;
    const show = (index: number) => {
      if (!track || images.length === 0) return;
      current = (index + images.length) % images.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      thumbs.forEach((thumb, i) => thumb.classList.toggle("active", i === current));
    };
    thumbs.forEach((thumb, index) => thumb.addEventListener("click", () => show(index)));
    root.querySelector("[data-previous]")?.addEventListener("click", () => show(current - 1));
    root.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });
    root.addEventListener(
      "touchstart",
      (event) => {
        touchStart = event.touches[0].clientX;
      },
      { passive: true },
    );
    root.addEventListener(
      "touchend",
      (event) => {
        const distance = event.changedTouches[0].clientX - touchStart;
        if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
      },
      { passive: true },
    );
  });
</script>
