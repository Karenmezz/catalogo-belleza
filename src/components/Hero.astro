---
interface Props { titulo:string; textoDestacado:string; descripcion:string; }
const { titulo, textoDestacado, descripcion } = Astro.props;
---
<section class="hero" id="inicio"><div class="contenido"><p class="etiqueta">Belleza elegida para ti</p><h1>{titulo}<span>{textoDestacado}</span></h1><p class="descripcion">{descripcion}</p><a class="boton" href="#productos">Explorar productos</a></div><div class="imagen"><img src="/images/portada.jpg" alt="Selección de productos de belleza y skincare" /></div></section>
<style>
.hero{display:grid;grid-template-columns:1fr 1fr;min-height:650px;border-bottom:1px solid var(--color-borde)}.contenido{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(4rem,9vw,9rem)}.etiqueta{margin:0 0 1.5rem;color:var(--color-principal);font-size:.75rem;font-weight:700;letter-spacing:.16rem;text-transform:uppercase}h1{margin:0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.2rem,6vw,6.5rem);font-weight:500;letter-spacing:-.05em;line-height:.95}h1 span{display:block;color:var(--color-principal);font-style:italic}.descripcion{max-width:34rem;margin:2rem 0;color:var(--color-texto-suave);line-height:1.7}.boton{padding:1rem 1.5rem;color:#fff;background:var(--color-texto);font-size:.82rem;font-weight:700;letter-spacing:.06rem;text-decoration:none;text-transform:uppercase}.imagen{min-height:500px;background:var(--color-superficie);overflow:hidden}.imagen img{width:100%;height:100%;object-fit:cover}@media(max-width:980px){.contenido{padding:clamp(3rem,6vw,5rem)}h1{font-size:clamp(2.9rem,7vw,4.8rem)}}@media(max-width:780px){.hero{grid-template-columns:1fr}.contenido{min-height:480px;padding:4rem 1.5rem}.imagen{min-height:390px;max-height:520px}}@media(max-width:420px){.contenido{min-height:430px;padding:3rem 1rem}h1{font-size:2.8rem}.descripcion{margin:1.5rem 0}.imagen{min-height:320px}}
</style>
