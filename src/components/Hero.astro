---
interface Props {
  titulo: string;
  textoDestacado: string;
  descripcion: string;
}
const { titulo, textoDestacado, descripcion } = Astro.props;
---

<section class="hero" id="inicio">
  <div class="contenido">
    <p class="etiqueta">Belleza elegida para ti</p><h1>
      {titulo}<span>{textoDestacado}</span>
    </h1><p class="descripcion">{descripcion}</p><a class="boton" href="#productos"
      >Explorar productos</a
    >
  </div><div class="imagen">
    <img src="/images/portada.jpg" alt="Selección de productos de belleza y skincare" />
  </div>
</section>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 460px;
    border-bottom: 1px solid var(--color-borde);
  }
  .contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5.25rem);
  }
  .etiqueta {
    margin: 0 0 1rem;
    color: var(--color-principal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16rem;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  h1 span {
    display: block;
    color: var(--color-principal);
    font-style: italic;
  }
  .descripcion {
    max-width: 34rem;
    margin: 1.25rem 0;
    color: var(--color-texto-suave);
    line-height: 1.7;
  }
  .boton {
    padding: 1rem 1.5rem;
    color: #fff;
    background: var(--color-texto);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06rem;
    text-decoration: none;
    text-transform: uppercase;
  }
  .imagen {
    min-height: 360px;
    background: var(--color-superficie);
    overflow: hidden;
  }
  .imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 980px) {
    .contenido {
      padding: clamp(2.25rem, 4.5vw, 3.75rem);
    }
    h1 {
      font-size: clamp(2.9rem, 7vw, 4.8rem);
    }
  }
  @media (max-width: 780px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .contenido {
      min-height: 350px;
      padding: 2.5rem 1.5rem;
    }
    .imagen {
      min-height: 290px;
      max-height: 380px;
    }
  }
  @media (max-width: 420px) {
    .contenido {
      min-height: 320px;
      padding: 2rem 1rem;
    }
    h1 {
      font-size: 2.8rem;
    }
    .descripcion {
      margin: 1rem 0;
    }
    .imagen {
      min-height: 240px;
    }
  }
</style>
