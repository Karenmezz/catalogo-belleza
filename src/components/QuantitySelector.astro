---
interface Props { max: number; }
const { max } = Astro.props;
---
<div class="quantity" data-quantity><button type="button" data-minus aria-label="Disminuir cantidad" disabled={max === 0}>−</button><label><span>Cantidad</span><input data-quantity-input type="number" min="1" max={max} value={max === 0 ? 0 : 1} inputmode="numeric" disabled={max === 0} /></label><button type="button" data-plus aria-label="Aumentar cantidad" disabled={max === 0}>+</button></div>
<style>.quantity{display:inline-grid;grid-template-columns:46px 68px 46px;border:1px solid var(--color-borde)}button,input{height:48px;border:0;background:#fff;text-align:center}button{font-size:1.2rem;cursor:pointer}button:hover{background:var(--color-superficie)}label span{position:absolute;overflow:hidden;width:1px;height:1px;clip:rect(0,0,0,0)}input{width:100%;font-weight:700;-moz-appearance:textfield}input::-webkit-inner-spin-button{appearance:none}</style>
<script>document.querySelectorAll('[data-quantity]').forEach((root)=>{const input=root.querySelector<HTMLInputElement>('[data-quantity-input]');root.querySelector('[data-minus]')?.addEventListener('click',()=>{if(input)input.value=String(Math.max(1,Number(input.value)-1))});root.querySelector('[data-plus]')?.addEventListener('click',()=>{if(input)input.value=String(Math.min(Number(input.max),Number(input.value)+1))});input?.addEventListener('change',()=>{input.value=String(Math.min(Number(input.max),Math.max(1,Number(input.value)||1)))})});</script>
