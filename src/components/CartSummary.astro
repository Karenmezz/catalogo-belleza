---
import { siteConfig } from "../config/site";
---
<section class="cart-layout" data-cart-page data-whatsapp={siteConfig.whatsapp}>
  <div><div class="title"><h1>Mi selección</h1><span data-heading-count></span></div><div class="items" data-cart-items></div><div class="empty" data-empty hidden><h2>Tu selección está vacía</h2><p>Explora el catálogo y agrega los productos que te interesan.</p><a href="/#productos">Ver productos</a></div></div>
  <aside data-summary><h2>Resumen</h2><div class="summary-row"><span>Productos</span><strong data-total-items>0</strong></div><div class="summary-row total"><span>Total estimado</span><strong data-total>$0</strong></div><p>La disponibilidad y el precio final serán confirmados por WhatsApp.</p><a class="whatsapp" data-whatsapp-link href="#" target="_blank" rel="noopener noreferrer">Consultar mi carrito por WhatsApp</a><a class="cart-link" data-cart-link href="#" target="_blank">Ver enlace de mi carrito</a></aside>
</section>
<style>
.cart-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.7fr);gap:clamp(3rem,8vw,8rem);width:min(var(--ancho-contenido),calc(100% - 3rem));min-height:65vh;margin:auto;padding:5rem 0}.title{display:flex;align-items:baseline;justify-content:space-between;border-bottom:1px solid var(--color-texto)}h1{margin:0 0 1.5rem;font-size:clamp(2.2rem,5vw,4rem)}:global(.item){display:grid;grid-template-columns:140px 1fr auto;gap:1.25rem;padding:1.5rem 0;border-bottom:1px solid var(--color-borde)}:global(.item img){width:140px;height:170px;object-fit:cover;background:var(--color-superficie)}:global(.item h2){margin:0 0 .5rem;font-size:1rem}:global(.item h2 a){text-decoration:none}:global(.item-price){font-weight:700}:global(.controls){display:flex;align-items:center;gap:.5rem;margin-top:1.25rem}:global(.controls button),:global(.controls input){height:36px;border:1px solid var(--color-borde);border-radius:4px;background:#fff}:global(.controls button){width:36px;font-weight:700;cursor:pointer}:global(.controls button:hover){color:#fff;background:var(--color-texto)}:global(.controls input){width:48px;text-align:center}:global(.remove){margin-top:.8rem!important;width:auto!important;padding:0!important;border:0!important;background:transparent!important;font-size:.8rem;text-decoration:underline;cursor:pointer}aside{align-self:start;padding:2rem;border:1px solid var(--color-borde);border-radius:10px;background:#fff;position:sticky;top:100px}aside h2{margin:0 0 1.5rem}.summary-row{display:flex;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--color-borde)}.summary-row.total{font-size:1.1rem}.summary-row+aside p,aside>p{color:var(--color-texto-suave);font-size:.82rem;line-height:1.5}.whatsapp,.empty a{display:block;margin-top:1.5rem;padding:1rem;border-radius:6px;color:#fff;background:var(--color-whatsapp);font-size:.78rem;font-weight:700;text-align:center;text-decoration:none;text-transform:uppercase}.empty{padding:4rem 0}.empty a{display:inline-block;background:var(--color-texto)}@media(max-width:800px){.cart-layout{grid-template-columns:1fr;padding:3rem 0}:global(.item){grid-template-columns:100px 1fr}:global(.item img){width:100px;height:125px}:global(.item-price){grid-column:2}aside{position:static}}
.cart-link{display:block;margin-top:.8rem;padding:.8rem;border:1px solid var(--color-borde);border-radius:6px;font-size:.76rem;font-weight:700;text-align:center;text-decoration:none;text-transform:uppercase}.cart-link:hover{border-color:var(--color-texto)}
  :global(.item img){width:140px;height:auto;aspect-ratio:1/1;padding:.35rem;object-fit:contain}@media(max-width:800px){:global(.item img){width:100px;height:auto}}
</style>
<script>
import { getCart,removeFromCart,updateQuantity } from '../scripts/cart';
const root=document.querySelector<HTMLElement>('[data-cart-page]');
const money=new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0});
const escapeHtml=(value:string)=>value.replace(/[&<>'"]/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[char]||char));
function render(){if(!root)return;const items=getCart();const list=root.querySelector<HTMLElement>('[data-cart-items]');const empty=root.querySelector<HTMLElement>('[data-empty]');const summary=root.querySelector<HTMLElement>('[data-summary]');const count=items.reduce((n,item)=>n+item.cantidad,0);const total=items.reduce((n,item)=>n+item.precio*item.cantidad,0);if(list)list.innerHTML=items.map(item=>`<article class="item"><img src="${escapeHtml(item.imagen)}" alt="${escapeHtml(item.nombre)}"><div><h2><a href="/productos/${encodeURIComponent(item.slug)}">${escapeHtml(item.nombre)}</a></h2><span>${money.format(item.precio)} cada uno</span><div class="controls"><button data-dec="${item.id}" aria-label="Disminuir cantidad">−</button><input value="${item.cantidad}" readonly aria-label="Cantidad"><button data-inc="${item.id}" aria-label="Aumentar cantidad">+</button></div><button class="remove" data-remove="${item.id}">Eliminar</button></div><strong class="item-price">${money.format(item.precio*item.cantidad)}</strong></article>`).join('');if(empty)empty.hidden=items.length>0;if(summary)summary.hidden=items.length===0;root.querySelector('[data-heading-count]')!.textContent=`${count} ${count===1?'producto':'productos'}`;root.querySelector('[data-total-items]')!.textContent=String(count);root.querySelector('[data-total]')!.textContent=money.format(total);const lines=items.map(item=>`• ${item.cantidad} × ${item.nombre} — ${money.format(item.precio*item.cantidad)}`);const message=`Hola, quisiera confirmar la disponibilidad de:\n\n${lines.join('\n')}\n\nTotal estimado: ${money.format(total)}`;const link=root.querySelector<HTMLAnchorElement>('[data-whatsapp-link]');if(link)link.href=`https://wa.me/${root.dataset.whatsapp}?text=${encodeURIComponent(message)}`;}
const updateShareLinks=()=>{if(!root)return;const items=getCart();const encodedItems=items.map(item=>`${item.id}:${item.cantidad}`).join(',');const cartUrl=`${window.location.origin}/consulta?items=${encodeURIComponent(encodedItems)}`;const total=items.reduce((sum,item)=>sum+item.precio*item.cantidad,0);const lines=items.map(item=>`• ${item.cantidad} × ${item.nombre} — ${money.format(item.precio*item.cantidad)}`);const message=`Hola, quisiera confirmar la disponibilidad de:\n\n${lines.join('\n')}\n\nTotal estimado: ${money.format(total)}\n\nConsulta mi carrito:\n${cartUrl}`;const whatsapp=root.querySelector<HTMLAnchorElement>('[data-whatsapp-link]');const cartLink=root.querySelector<HTMLAnchorElement>('[data-cart-link]');if(whatsapp)whatsapp.href=`https://wa.me/${root.dataset.whatsapp}?text=${encodeURIComponent(message)}`;if(cartLink)cartLink.href=cartUrl;};
root?.addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('button');if(!button)return;const items=getCart();const id=Number(button.dataset.inc||button.dataset.dec||button.dataset.remove);const item=items.find(entry=>entry.id===id);if(button.dataset.remove){removeFromCart(id)}else if(item){updateQuantity(id,item.cantidad+(button.dataset.inc?1:-1))}render();updateShareLinks()});render();updateShareLinks();window.addEventListener('cart:updated',updateShareLinks);
</script>
