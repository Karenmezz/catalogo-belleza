---
interface Props {
  nombreTienda: string;
}

const { nombreTienda } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div>
    <strong>{nombreTienda}</strong>
    <p>Productos de belleza seleccionados para ti.</p>
  </div>

  <p>© {currentYear} {nombreTienda}</p>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 3rem 8%;
    color: var(--color-texto);
    background-color: var(--color-superficie);
    border-top: 1px solid var(--color-borde);
  }

  .footer strong {
    font-size: 1.25rem;
  }

  .footer p {
    margin: 0.5rem 0 0;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 3rem 1.5rem;
    }
  }
</style>
