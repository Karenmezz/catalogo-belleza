---
import ProductCard from "./ProductCard.astro";
import { Search, RotateCcw } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  products: CollectionEntry<"products">[];
  titulo?: string;
  favoritos?: boolean;
}
const { products, titulo = "Productos de belleza y skincare", favoritos = false } = Astro.props;
const marcas = [
  ...products
    .reduce((uniqueBrands, product) => {
      const marca = product.data.marca.trim();
      const normalizedBrand = marca.toLocaleLowerCase("es");
      if (!uniqueBrands.has(normalizedBrand)) uniqueBrands.set(normalizedBrand, marca);
      return uniqueBrands;
    }, new Map<string, string>())
    .values(),
].sort((a, b) => a.localeCompare(b, "es", { sensitivity: "base" }));
---

<section
  class="catalog"
  id="productos"
  data-product-grid
  data-favorites-only={favoritos ? "true" : "false"}
>
  <header class="heading">
    <div>
      <p class="eyebrow">
        {favoritos ? "Tu lista personal" : "Nuestro catálogo"}
      </p><h2>{titulo}</h2>
    </div><p class="counter" data-visible-count>
      {products.length}
      {products.length === 1 ? "producto" : "productos"}
    </p>
  </header>
  <div class="toolbar">
    <div class="left-filters">
      <label class="search"
        ><Search size={18} strokeWidth={2} /><span class="sr-only">Buscar productos</span><input
          type="search"
          data-search
          placeholder="Buscar productos…"
          autocomplete="off"
        /></label
      >
      <label
        ><span class="sr-only">Marca</span><select data-brand
          ><option value="todos">Todas las marcas</option>{
            marcas.map((marca) => <option value={marca.toLowerCase()}>{marca}</option>)
          }</select
        ></label
      >
      <label
        ><span class="sr-only">Ordenar productos</span><select data-product-order
          ><option value="default">Ordenar por</option><option value="recent"
            >Agregados recientemente</option
          ><option value="price-asc"
            >Precio: bajo a alto</option
          ><option value="price-desc">Precio: alto a bajo</option></select
        ></label
      >
      <button class="clear" type="button" data-clear-filters title="Limpiar filtros"
        ><RotateCcw size={15} /><span>Limpiar</span></button
      >
    </div>
    <div class="categories" aria-label="Filtrar por categoría">
      <button class="active" type="button" data-category="todos">Todos</button><button
        type="button"
        data-category="maquillaje">Maquillaje</button
      ><button type="button" data-category="skincare">Skincare</button><button
        type="button"
        data-category="cuidado-capilar">Cuidado capilar</button
      ><button type="button" data-category="cuidado-corporal">Cuidado corporal</button>
    </div>
  </div>
  <div class="grid">
    {products.map((product) => <ProductCard product={product} />)}
  </div>
  <div class="no-results" data-no-results hidden>
    <h3>No encontramos productos</h3><p>Prueba cambiando o limpiando los filtros.</p><button
      type="button"
      data-clear-filters>Limpiar filtros</button
    >
  </div>
</section>
<style>
  .catalog {
    width: min(1400px, calc(100% - 4rem));
    margin: 0 auto;
    padding: 5rem 0 7rem;
  }
  .heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-principal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
  }
  h2 {
    max-width: 45rem;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
  }
  .counter {
    margin: 0;
    color: var(--color-texto-suave);
  }
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    background: var(--color-superficie);
  }
  .left-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 0 1 280px;
    width: clamp(200px, 20vw, 280px);
    padding: 0 0.9rem;
    border: 1px solid #d5d5d5;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 8px rgb(0 0 0/0.04);
  }
  .search :global(svg) {
    flex: 0 0 auto;
    color: var(--color-principal);
  }
  .search:focus-within {
    border-color: var(--color-principal);
    box-shadow: 0 0 0 3px rgb(155 53 87/0.12);
  }
  .search input {
    width: 100%;
    height: 42px;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 0.82rem;
  }
  .left-filters select {
    width: auto;
    min-width: 0;
    max-width: 165px;
    height: 42px;
    padding: 0 1.9rem 0 0.75rem;
    border: 1px solid #d8d8d8;
    border-radius: 999px;
    outline: 0;
    background: #fff;
    font-size: 0.7rem;
  }
  .left-filters select:focus {
    border-color: var(--color-principal);
  }
  .clear {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    height: 40px;
    padding: 0 0.55rem;
    border: 0;
    color: var(--color-texto-suave);
    background: transparent;
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
  }
  .clear:hover {
    color: var(--color-principal);
  }
  .categories {
    display: flex;
    flex: 0 0 auto;
    gap: 0.4rem;
  }
  .categories button {
    padding: 0.68rem 0.82rem;
    border: 1px solid #d8d8d8;
    border-radius: 999px;
    background: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .categories button:hover {
    transform: translateY(-1px);
  }
  .categories button:hover,
  .categories button.active {
    color: #fff;
    border-color: var(--color-texto);
    background: var(--color-texto);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.35rem;
  }
  .no-results {
    padding: 5rem 1rem;
    text-align: center;
    color: var(--color-texto-suave);
  }
  .no-results h3 {
    color: var(--color-texto);
  }
  .no-results button {
    margin-top: 0.75rem;
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: 6px;
    color: #fff;
    background: var(--color-texto);
    cursor: pointer;
  }
  @media (max-width: 1200px) {
    .toolbar {
      align-items: flex-start;
      overflow-x: auto;
    }
    .left-filters,
    .categories {
      flex: 0 0 auto;
    }
    .search {
      width: 230px;
    }
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .catalog {
      width: min(100% - 2rem, 1400px);
      padding: 4rem 0;
    }
    .heading {
      display: block;
      padding-bottom: 2rem;
    }
    .counter {
      margin-top: 1rem;
    }
    .toolbar {
      display: block;
      overflow: visible;
    }
    .left-filters {
      overflow-x: auto;
      padding-bottom: 0.75rem;
    }
    .categories {
      overflow-x: auto;
      padding-top: 0.75rem;
      border-top: 1px solid #e2e2e2;
    }
    .search {
      flex-basis: 230px;
    }
    .clear span {
      display: none;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 0.75rem;
    }
  }
  @media (max-width: 480px) {
    .toolbar {
      padding: 0.8rem;
    }
    .left-filters select {
      max-width: 145px;
    }
    .categories button {
      padding: 0.62rem 0.75rem;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 380px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<script>
  import { getFavorites } from "../scripts/favorites";
  document.querySelectorAll<HTMLElement>("[data-product-grid]").forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-product-card]")];
    cards.forEach((card) => {
      card.hidden = false;
      card.style.display = "flex";
    });
    const search = root.querySelector<HTMLInputElement>("[data-search]");
    const brand = root.querySelector<HTMLSelectElement>("[data-brand]");
    const productOrder = root.querySelector<HTMLSelectElement>("[data-product-order]");
    const categoryButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-category]")];
    const empty = root.querySelector<HTMLElement>("[data-no-results]");
    const count = root.querySelector<HTMLElement>("[data-visible-count]");
    let category = "todos";
    const initialCategory = new URLSearchParams(location.search).get("categoria");
    if (
      initialCategory &&
      categoryButtons.some((button) => button.dataset.category === initialCategory)
    )
      category = initialCategory;
    const render = () => {
      try {
        const term = (search?.value || "")
          .trim()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLocaleLowerCase("es");
        const selectedBrand = brand?.value || "todos";
        const favoriteIds = root.dataset.favoritesOnly === "true" ? getFavorites() : [];
        let visible = 0;
        cards.forEach((card) => {
          const show =
            (card.dataset.productSearch || card.dataset.productName || "").includes(term) &&
            (selectedBrand === "todos" || card.dataset.productBrand === selectedBrand) &&
            (category === "todos" || card.dataset.productCategory === category) &&
            (root.dataset.favoritesOnly !== "true" ||
              favoriteIds.includes(Number(card.dataset.productId)));
          card.hidden = !show;
          card.style.display = show ? "flex" : "none";
          if (show) visible++;
        });
        const ordered = [...cards];
        if (productOrder?.value === "recent")
          ordered.sort((a, b) => Number(b.dataset.productOrder) - Number(a.dataset.productOrder));
        else if (productOrder?.value === "price-asc")
          ordered.sort((a, b) => Number(a.dataset.productPrice) - Number(b.dataset.productPrice));
        else if (productOrder?.value === "price-desc")
          ordered.sort((a, b) => Number(b.dataset.productPrice) - Number(a.dataset.productPrice));
        else ordered.sort((a, b) => Number(a.dataset.productOrder) - Number(b.dataset.productOrder));
        ordered.forEach((card, index) => (card.style.order = String(index)));
        categoryButtons.forEach((button) =>
          button.classList.toggle("active", button.dataset.category === category),
        );
        if (empty) empty.hidden = visible > 0;
        if (count) count.textContent = `${visible} ${visible === 1 ? "producto" : "productos"}`;
      } catch (error) {
        console.error("No se pudieron aplicar los filtros", error);
        cards.forEach((card) => {
          card.hidden = false;
          card.style.display = "flex";
        });
      }
    };
    const clear = () => {
      if (search) search.value = "";
      if (brand) brand.value = "todos";
      if (productOrder) productOrder.value = "default";
      category = "todos";
      render();
    };
    search?.addEventListener("input", render);
    brand?.addEventListener("change", render);
    productOrder?.addEventListener("change", render);
    categoryButtons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.category || "todos";
        render();
      }),
    );
    root
      .querySelectorAll("[data-clear-filters]")
      .forEach((button) => button.addEventListener("click", clear));
    window.addEventListener("favorites:updated", render);
    render();
  });
</script>
