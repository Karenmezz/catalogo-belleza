---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProductGrid from "../components/ProductGrid.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
const products = (await getCollection("products", ({ data }) => data.activo))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<BaseLayout title={`Favoritos | ${siteConfig.nombre}`} description="Tus productos de belleza y skincare favoritos.">
  <Header nombreTienda={siteConfig.nombre} />
  <main><ProductGrid products={products} titulo="Mis productos favoritos" favoritos={true} /></main>
  <Footer nombreTienda={siteConfig.nombre} />
</BaseLayout>
