---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BenefitsBanner from "../components/BenefitsBanner.astro";
import ProductGrid from "../components/ProductGrid.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";

const products = (await getCollection("products", ({ data }) => data.activo)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<BaseLayout title={`${siteConfig.nombre} | Catálogo`} description={siteConfig.descripcion}>
  <Header nombreTienda={siteConfig.nombre} />

  <main>
    <Hero
      titulo="Detalles que hacen"
      textoDestacado="brillar tu esencia"
      descripcion="Descubre productos elegidos para acompañar tus rituales de cuidado, maquillaje y belleza."
    />

    <BenefitsBanner />

    <ProductGrid products={products} />
  </main>

  <Footer nombreTienda={siteConfig.nombre} />
</BaseLayout>
